# ==========================================
# Belzo Hyperlocal Quick-Commerce Monorepo
# Enterprise-Grade .gitignore
# ==========================================

# Dependencies & Package Managers
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store

# Testing & Coverage
coverage/
*.lcov
.nyc_output

# Next.js Build Outputs
.next/
out/
build/
dist/

# Turbo & Monorepo Caches
.turbo/
*.tsbuildinfo

# Expo, Metro & React Native
.expo/
.expo-shared/
web-build/
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
*.orig.*
ios/Pods/
ios/build/
android/app/build/
android/.gradle/
android/build/

# Environment Secrets (NEVER COMMIT SENSITIVE KEYS)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# Credentials & Certificates
*.pem
*.cert
*.crt
id_rsa*
id_ed25519*

# System & OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Metadata
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary files & swap
*.swp
*.swo
*~
.temp/
tmp/
scratch/
