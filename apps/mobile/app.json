{
  "expo": {
    "name": "Belzo - 10 Min Grocery & Food",
    "slug": "belzo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "belzo",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF5E00"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.belzo.hyperlocal",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Belzo collects location data to find nearby dark stores and autofill your doorstep delivery address.",
        "NSCameraUsageDescription": "Belzo uses your camera to scan package barcodes and capture contactless delivery confirmation."
      }
    },
    "android": {
      "package": "com.belzo.hyperlocal",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF5E00"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "INTERNET",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Belzo collects location data to find nearby dark stores and autofill your doorstep delivery address."
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
