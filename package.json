{
  "name": "belzo-app",
  "version": "1.0.0",
  "private": true,
  "description": "Belzo - Hyperlocal Quick-Commerce Ecosystem Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "seed": "npx ts-node packages/supabase/scripts/seed.ts",
    "build:admin": "npm run build --workspace=apps/admin"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
